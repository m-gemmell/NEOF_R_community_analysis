library("tidyverse")
set.seed(222)
Dosage <- c(sample(10:100,25), sample(100:500,25), sample(500:1000,25),
sample(10:100,25), sample(100:750,25), sample(500:1000,25))
Ecoli <- c(sample(75:150,25), sample(80:180,25), sample(100:250,25),
sample(50:100,25), sample(20:80,25), sample(1:40,25))
Ecoli <- Ecoli/10
#AMR shows if AMR was found in Ecoli (AMR) or not (no_AMR)
AMR <- c(rep(x = "AMR", times = 75), rep(x = "no_AMR", times = 75))
#Tibble
tbl <- tibble::tibble(Dosage, Ecoli, AMR)
set.seed(NULL)
#filter tbl
amr_tbl <- tbl |> dplyr::filter(AMR=="AMR")
no_amr_tbl <- tbl |> dplyr::filter(AMR=="no_AMR")
#linear regressions
#Calculate linear model
ecoli_lm <- lm(Ecoli ~ Dosage, data = tbl)
#Intercept and gradient
c <- ecoli_lm$coefficients[1]
m <- ecoli_lm$coefficients[2]
#no AMR Calculate linear model
ecoli_lm <- lm(Ecoli ~ Dosage, data = no_amr_tbl)
#Intercept and gradient
no_amr_c <- ecoli_lm$coefficients[1]
no_amr_m <- ecoli_lm$coefficients[2]
#AMR Calculate linear model
amr_lm <- lm(Ecoli ~ Dosage, data = amr_tbl)
#Intercept and gradient
amr_c <- ecoli_lm$coefficients[1]
amr_m <- ecoli_lm$coefficients[2]
#equation
AMR_lm_equation <- stringr::str_c(
"y = ", as.character(round(m, digits=2)),"x + ",as.character(round(amr_c,digits=2))
)
no_AMR_lm_equation <- stringr::str_c(
"y = ", as.character(round(m, digits=2)),"x + ",as.character(round(no_amr_c,digits=2))
)
#plot
tbl |>  ggplot2::ggplot(aes(x=Dosage, y=Ecoli)) +
ggplot2::geom_abline(mapping = NULL, data = NULL, stat="identity", m, amr_c) +
ggplot2::geom_abline(mapping = NULL, data = NULL, stat="identity", m, no_amr_c) +
ggplot2::geom_point(aes(color=AMR)) +
ggplot2::annotate("text", x = 100, y = 22, label = lm_equation) +
ggplot2::labs(x = "Antibiotic dosage (mg/kg)", y = "E.coli relative abundance (%)")
#plot
tbl |>  ggplot2::ggplot(aes(x=Dosage, y=Ecoli)) +
ggplot2::geom_abline(mapping = NULL, data = NULL, stat="identity", m, amr_c) +
ggplot2::geom_abline(mapping = NULL, data = NULL, stat="identity", m, no_amr_c) +
ggplot2::geom_point(aes(color=AMR)) +
ggplot2::annotate("text", x = 100, y = 22, label = AMR_lm_equation) +
ggplot2::labs(x = "Antibiotic dosage (mg/kg)", y = "E.coli relative abundance (%)")
#plot
tbl |>  ggplot2::ggplot(aes(x=Dosage, y=Ecoli)) +
ggplot2::geom_abline(slope=m, intercept=amr_c) +
ggplot2::geom_abline(slope=m, intercept=no_amr_c) +
ggplot2::geom_point(aes(color=AMR)) +
ggplot2::annotate("text", x = 100, y = 22, label = AMR_lm_equation) +
ggplot2::labs(x = "Antibiotic dosage (mg/kg)", y = "E.coli relative abundance (%)")
#filter tbl
amr_tbl <- tbl |> dplyr::filter(AMR=="AMR")
no_amr_tbl <- tbl |> dplyr::filter(AMR=="no_AMR")
#linear regressions
#Calculate linear model
ecoli_lm <- lm(Ecoli ~ Dosage, data = tbl)
#Intercept and gradient
c <- ecoli_lm$coefficients[1]
m <- ecoli_lm$coefficients[2]
#no AMR Calculate linear model
no_amr_lm <- lm(Ecoli ~ Dosage, data = no_amr_tbl)
#Intercept and gradient
no_amr_c <- no_amr_lm$coefficients[1]
no_amr_m <- no_amr_lm$coefficients[2]
#AMR Calculate linear model
amr_lm <- lm(Ecoli ~ Dosage, data = amr_tbl)
#Intercept and gradient
amr_c <- amr_lm$coefficients[1]
amr_m <- amr_lm$coefficients[2]
#equation
AMR_lm_equation <- stringr::str_c(
"y = ", as.character(round(m, digits=2)),"x + ",as.character(round(amr_c,digits=2))
)
no_AMR_lm_equation <- stringr::str_c(
"y = ", as.character(round(m, digits=2)),"x + ",as.character(round(no_amr_c,digits=2))
)
#plot
tbl |>  ggplot2::ggplot(aes(x=Dosage, y=Ecoli)) +
ggplot2::geom_abline(slope = m, intercept = amr_c) +
ggplot2::geom_abline(slope = m, intercept=no_amr_c) +
ggplot2::geom_point(aes(color=AMR)) +
ggplot2::annotate("text", x = 100, y = 22, label = AMR_lm_equation) +
ggplot2::annotate("text", x = 100, y = 2, label = no_AMR_lm_equation) +
ggplot2::labs(x = "Antibiotic dosage (mg/kg)", y = "E.coli relative abundance (%)")
